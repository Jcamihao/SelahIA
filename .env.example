PORT=3010
NODE_ENV=development
SELAH_SERVICE_NAME=selah-ia
SELAH_DEFAULT_LOCALE=pt-BR
SELAH_PUBLIC_VERSION=v1
SELAH_BODY_SIZE_LIMIT=20mb

# Autenticacao por app (recomendado): App:chave separados por virgula. Gere cada chave com: openssl rand -hex 32
# A chave define quem e o app; o header X-Source-App deixa de valer como identidade.
# Para rotacionar, liste duas chaves do mesmo app e remova a antiga depois.
# Exemplo (nomes de app dos consumidores): SELAH_APP_KEYS=LumenBack:<chave>,PraiseAppBack:<chave>,AgilisBack:<chave>,BalancoGorduraBack:<chave>,NottaPsiBack:<chave>
SELAH_APP_KEYS=

# Rate limit por app, em requisicoes por minuto (padrao 60; 0 desliga). Sobrescrita por app: LumenBack:120,PraiseAppBack:30
SELAH_RATE_LIMIT_PER_MINUTE=60
SELAH_RATE_LIMITS=

# LEGADO: chaves sem identidade de app (a identidade vem do header X-Source-App, que e falsificavel).
# Serve so para dev local; em producao use SELAH_APP_KEYS e remova esta variavel.
# Em producao o Selah recusa subir com a chave selah-dev-key.
SELAH_INTERNAL_API_KEYS=selah-dev-key
# Vale so para as chaves legadas.
SELAH_ALLOWED_SOURCE_APPS=PraiseAppBack,LumenBack,BalancoGorduraBack

# Provider de LLM: gemini (padrao) ou ollama. Vazio = gemini; use LLM_PROVIDER=ollama para rodar local.
LLM_PROVIDER=gemini

# Usado somente quando LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_MS=120000

# Obrigatoria com o provider padrao (gemini). Gere a key em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Orcamento total por chamada (inclui retries). Retry so em 429/5xx/erro de rede.
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_MS=800
GEMINI_RETRY_MAX_DELAY_MS=8000
GEMINI_STRUCTURED_THINKING_BUDGET=0
# Tentativas extras quando o Gemini devolve JSON invalido ou fora do schema (0 desliga, maximo 2).
# Cada tentativa e uma chamada completa: o pior caso e (1 + valor) x GEMINI_TIMEOUT_MS.
GEMINI_INVALID_JSON_RETRIES=1

# Protecao contra provedor lento ou fora do ar (valem para qualquer provider).
# Chamadas simultaneas ao LLM (0 desliga). Acima disso entram na fila; fila cheia ou espera longa = 503 PROVIDER_BUSY.
LLM_MAX_CONCURRENCY=10
LLM_MAX_QUEUE=20
LLM_QUEUE_TIMEOUT_MS=20000
# Circuit breaker: apos N falhas transitorias seguidas (rede, timeout, 5xx) para de chamar por LLM_CIRCUIT_OPEN_MS
# e responde 503 PROVIDER_UNAVAILABLE. 0 desliga.
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_MS=30000

# Teto diario de tokens por app (soma de prompt + saida), em memoria, zera na virada do dia UTC. 0 = sem teto.
# So conta com o provider gemini (o Ollama nao informa tokens). Estourou = 429 DAILY_TOKEN_BUDGET_EXCEEDED.
SELAH_DAILY_TOKEN_BUDGET=0
# Sobrescrita por app: LumenBack:2000000,PraiseAppBack:500000 (0 libera aquele app)
SELAH_TOKEN_BUDGETS=

# Proxies em que o Selah confia para ler o IP do cliente (X-Forwarded-For). Padrao: loopback e faixas privadas
# (o nginx do mesmo servidor, atras do Docker). Aceita false, numero de saltos, loopback/linklocal/uniquelocal, IPs e CIDRs.
# Nao use true: deixaria o cliente forjar o IP registrado nos logs.
SELAH_TRUST_PROXY=loopback,uniquelocal

# Deploy de producao (docker-compose.prod.yml): copie pra .env.production no servidor.
# Porta do host (bind em 127.0.0.1, o nginx faz o proxy).
SELAH_HOST_PORT=3020
